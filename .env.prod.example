# Copy to .env.prod and replace every production secret before starting the prod profile.
# These service hostnames run the prod Spring profile against the local Compose data tier.
POSTGRES_DB=ecp
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-production-password
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/ecp
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=replace-with-the-same-production-password

ECP_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

ECP_CURSOR_ACTIVE_KEY_ID=cursor-v1
ECP_CURSOR_ACTIVE_KEY=replace-with-a-long-random-cursor-signing-key
ECP_CURSOR_PREVIOUS_KEY_ID=
ECP_CURSOR_PREVIOUS_KEY=

ECP_REDIS_CACHE_HOST=redis-cache
ECP_REDIS_CACHE_PORT=6379
ECP_REDIS_STATE_HOST=redis-state
ECP_REDIS_STATE_PORT=6379

# Paths are inside the app container; the repository is mounted at /workspace.
ECP_JWT_PRIVATE_KEY_PATH=/workspace/.secrets/jwt-private.pem
ECP_JWT_PUBLIC_KEY_PATH=/workspace/.secrets/jwt-public.pem
ECP_JWT_ISSUER=ecp-api
ECP_JWT_ACCESS_TTL_SECONDS=900

ECP_OUTBOX_POLL_DELAY_MS=1000
ECP_OUTBOX_BATCH_SIZE=100

ECP_REVALIDATION_URL=
ECP_REVALIDATE_SECRET=
ECP_REVALIDATION_CONSUMER_GROUP=ecp.web-revalidation

ECP_MANAGEMENT_PORT=9001
