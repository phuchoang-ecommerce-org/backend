#!/bin/sh
set -eu

# Match generated-file ownership to the current host user. Docker Desktop does
# not expose its VM's socket group on macOS, where group 0 is the useful default.
LOCAL_UID="${LOCAL_UID:-$(id -u)}"
LOCAL_GID="${LOCAL_GID:-$(id -g)}"
DOCKER_GID="${DOCKER_GID:-0}"

if [ -S /var/run/docker.sock ]; then
    DOCKER_GID="$(stat -c '%g' /var/run/docker.sock 2>/dev/null \
        || stat -f '%g' /var/run/docker.sock)"
fi

export LOCAL_UID LOCAL_GID DOCKER_GID

exec docker compose run --rm --build gradle "$@"
