# Development-only defaults for `./gradlew :app:bootRun`.
# bootRun loads .env when present, otherwise it loads this file. Copy it to .env and replace the
# cursor key before sharing environments or deploying anywhere outside your machine.

SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecp
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=secret

ECP_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

ECP_CURSOR_ACTIVE_KEY_ID=cursor-v1
ECP_CURSOR_ACTIVE_KEY=local-development-cursor-secret-0001
ECP_CURSOR_PREVIOUS_KEY_ID=
ECP_CURSOR_PREVIOUS_KEY=

ECP_REDIS_CACHE_HOST=localhost
ECP_REDIS_CACHE_PORT=6379
ECP_REDIS_STATE_HOST=localhost
ECP_REDIS_STATE_PORT=6380

ECP_JWT_PRIVATE_KEY_PATH=
ECP_JWT_PUBLIC_KEY_PATH=
ECP_JWT_GENERATE_DEV_KEYS=true
ECP_JWT_ISSUER=ecp-api
ECP_JWT_ACCESS_TTL_SECONDS=900

ECP_OUTBOX_POLL_DELAY_MS=1000
ECP_OUTBOX_BATCH_SIZE=100

ECP_REVALIDATION_URL=
ECP_REVALIDATE_SECRET=
ECP_REVALIDATION_CONSUMER_GROUP=ecp.web-revalidation

ECP_MANAGEMENT_PORT=9001
